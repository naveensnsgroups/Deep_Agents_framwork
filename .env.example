ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PORT=4000

ANTHROPIC_MODEL=anthropic:claude-sonnet-4-6
GOOGLE_MODEL=google-genai:gemini-3.6-flash
OPENAI_MODEL=openai:gpt-5.5
# Raw OpenRouter model id, no provider prefix — e.g. "anthropic/claude-sonnet-4.6"
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# --- Cloud deployment ---
# Set to 1 on any deployment reachable from outside localhost. Makes AUTH_TOKEN mandatory
# (the server refuses to start without it) and disables the local-disk folder browser.
CLOUD_MODE=

# Shared access token. Required when CLOUD_MODE=1. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Entered once in the browser at first load — never compiled into the web bundle.
AUTH_TOKEN=

# Comma-separated origins allowed to call this API, e.g. https://your-app.vercel.app
# Unset means reflect any origin, which is only appropriate locally.
ALLOWED_ORIGINS=

# --- GitHub login (per-user accounts) ---
# Set GITHUB_OAUTH_CLIENT_ID to switch from the shared AUTH_TOKEN to "Sign in with GitHub": each
# user then has their own saved API keys (encrypted), conversations, memories and sandboxes, and
# the server's own model keys above are never used for them. Create an OAuth App at
# https://github.com/settings/developers with callback URL <PUBLIC_URL>/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Signs session cookies and encrypts saved keys. At least 32 characters; rotating it signs everyone
# out and makes saved keys unreadable (users re-save them). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Where the app is reached, e.g. http://13.202.56.144 — the OAuth callback is built from it.
PUBLIC_URL=
# Comma-separated GitHub usernames allowed to sign in. "*" allows anyone — but every sandbox runs on
# this deployment's E2B account, so that lets strangers spend it.
ALLOWED_GITHUB_USERS=

# --- Agent execution sandbox ---
# Set to "e2b" to run the agent's shell commands and file edits inside a disposable E2B
# microVM instead of on this server. Requires E2B_API_KEY and a GitHub repo URL as the
# workspace (there is no local folder to operate on). Leave both unset for local development.
SANDBOX_PROVIDER=
E2B_API_KEY=

# How many E2B sandboxes one user may hold at once, and across the whole server. Every sandbox
# bills this deployment's E2B account, so one user must not use up its concurrency for everyone.
# Idle ones (tab closed, still in their grace period) are closed first to make room.
MAX_SANDBOXES_PER_USER=2
MAX_SANDBOXES=10

# --- Tracing (optional) ---
# LangSmith traces of every agent run: each model call, tool call and subagent, tagged with
# the user and repository, for finding out why a run failed or what it cost. Off unless both
# are set. Traces contain the project's source code; credentials in it are masked first.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-migration-agents-dev
# https://eu.api.smith.langchain.com for the EU region; blank for the US one.
LANGSMITH_ENDPOINT=
# "true" sends only each step's shape, timing, token counts and errors — no code or messages.
LANGSMITH_HIDE_INPUTS=
LANGSMITH_HIDE_OUTPUTS=

# --- Persistence ---
# Optional. Leave blank to keep conversations in local SQLite (apps/server/.data).
# Set to a MongoDB connection string to store conversations and /memories/ in MongoDB.
MONGODB_URI=
MONGODB_DB=deepagents_dev
