ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PORT=4000

ANTHROPIC_MODEL=anthropic:claude-sonnet-4-6
GOOGLE_MODEL=google-genai:gemini-3.6-flash
OPENAI_MODEL=openai:gpt-5.5
# Raw OpenRouter model id, no provider prefix — e.g. "anthropic/claude-sonnet-4.6"
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# --- Cloud deployment ---
# Set to 1 on any deployment reachable from outside localhost. Makes AUTH_TOKEN mandatory
# (the server refuses to start without it) and disables the local-disk folder browser.
CLOUD_MODE=

# Shared access token. Required when CLOUD_MODE=1. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Entered once in the browser at first load — never compiled into the web bundle.
AUTH_TOKEN=

# Comma-separated origins allowed to call this API, e.g. https://your-app.vercel.app
# Unset means reflect any origin, which is only appropriate locally.
ALLOWED_ORIGINS=

# --- Agent execution sandbox ---
# Set to "e2b" to run the agent's shell commands and file edits inside a disposable E2B
# microVM instead of on this server. Requires E2B_API_KEY and a GitHub repo URL as the
# workspace (there is no local folder to operate on). Leave both unset for local development.
SANDBOX_PROVIDER=
E2B_API_KEY=

# --- Persistence ---
# Optional. Leave blank to keep conversations in local SQLite (apps/server/.data).
# Set to a MongoDB connection string to store conversations and /memories/ in MongoDB.
MONGODB_URI=
MONGODB_DB=deepagents_dev
