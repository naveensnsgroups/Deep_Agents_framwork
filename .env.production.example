# Production values for the EC2/Docker deployment — copy to `.env.production`, fill in
# real values, and never commit the filled-in copy (`.env.*` is gitignored; only
# `*.example` files are tracked). docker-compose.yml loads this file into the container.

# At least one of these, matching whichever model(s) you actually use.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

ANTHROPIC_MODEL=anthropic:claude-sonnet-4-6
GOOGLE_MODEL=google-genai:gemini-3.6-flash
OPENAI_MODEL=openai:gpt-5.5
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

PORT=4000

# --- Cloud deployment — all three of these are effectively required in production ---

# Refuses to start without AUTH_TOKEN set, and turns off the local-disk folder browser
# (there is no "your machine's folders" on an EC2 box serving other people).
CLOUD_MODE=1

# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Entered once in the browser at first load. Never put this in the frontend build.
AUTH_TOKEN=

# The exact origin(s) the frontend is served from. Since server.ts now serves the built
# frontend itself on the same origin as the API (see the Docker image), this is normally
# just your one domain — e.g. https://migrate.yourdomain.com. Comma-separate if you ever
# split the frontend onto a different host. Leaving this blank reflects any origin, which
# is a real CSRF-adjacent risk once this is reachable from the internet — do not leave it
# blank in production.
ALLOWED_ORIGINS=

# --- GitHub login (per-user accounts) ---
# Set GITHUB_OAUTH_CLIENT_ID to switch from the shared AUTH_TOKEN to "Sign in with GitHub": each
# user then has their own saved API keys (encrypted), conversations, memories and sandboxes, and
# the server's own model keys above are never used for them. Create an OAuth App at
# https://github.com/settings/developers with callback URL <PUBLIC_URL>/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Signs session cookies and encrypts saved keys. At least 32 characters; rotating it signs everyone
# out and makes saved keys unreadable (users re-save them). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Where the app is reached, e.g. http://13.202.56.144 — the OAuth callback is built from it.
PUBLIC_URL=
# Comma-separated GitHub usernames allowed to sign in. "*" allows anyone — but every sandbox runs on
# this deployment's E2B account, so that lets strangers spend it.
ALLOWED_GITHUB_USERS=

# --- Agent execution sandbox ---

# "e2b" — strongly recommended in production even though EC2 has a real disk of its own.
# Without it, every agent shell command (`execute`) and file write runs with this
# container's own privileges on your production box; E2B isolates that into a disposable
# microVM instead. Required with CLOUD_MODE=1: the server refuses to start without it, and
# a cloud deployment only ever opens GitHub repositories, never folders on this host.
SANDBOX_PROVIDER=e2b
E2B_API_KEY=

# How many E2B sandboxes one user may hold at once, and across the whole server. Every sandbox
# bills this deployment's E2B account, so one user must not use up its concurrency for everyone.
# Idle ones (tab closed, still in their grace period) are closed first to make room.
MAX_SANDBOXES_PER_USER=2
MAX_SANDBOXES=10

# --- Tracing (optional) ---
# LangSmith traces of every agent run: each model call, tool call and subagent, tagged with
# the user's GitHub login and repository, for finding out why a run failed or what it cost.
# Off unless both are set.
#
# Traces contain your users' source code, sent to LangSmith (US by default). Credentials in it
# are masked before upload, but the code itself is not — tell your users, or set the two HIDE
# variables below. Store LANGSMITH_API_KEY as a secret, like the other keys.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-migration-agents
# https://eu.api.smith.langchain.com for the EU region; blank for the US one.
LANGSMITH_ENDPOINT=
# Fraction of runs to trace, 0 to 1. Blank traces every run.
LANGSMITH_TRACING_SAMPLING_RATE=
# "true" sends only each step's shape, timing, token counts and errors — no code or messages.
LANGSMITH_HIDE_INPUTS=
LANGSMITH_HIDE_OUTPUTS=

# --- Persistence ---

# MongoDB connection string (e.g. a free Atlas M0 cluster). When set, conversations, the
# migration ledger and /memories/ live in MongoDB, so they survive container replacement and
# are shared by every deployment pointing at it. When blank, local SQLite + files are used,
# which an ECS task loses on every redeploy.
MONGODB_URI=
# Use a different name per environment so development never touches deployed data.
MONGODB_DB=deepagents
